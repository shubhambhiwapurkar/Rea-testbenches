{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://summit.game/schema/peaks_osm.schema.json",
  "title": "SUMMIT machine-imported peak list",
  "description": "Data/Mountains/peaks_osm.json, generated by Tools/data/fetch_osm_peaks.py from OpenStreetMap (ODbL 1.0) and GeoNames (CC BY 4.0). Unreviewed; curated peaks.json always takes precedence.",
  "type": "object",
  "required": ["version", "licenses", "peaks"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "generated_at": {"type": "string"},
    "generator": {"type": "string"},
    "notes": {"type": "string"},
    "queries": {"type": "array", "items": {"type": "string"}},
    "licenses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dataset", "name", "url", "attribution"],
        "additionalProperties": false,
        "properties": {
          "dataset": {"type": "string", "enum": ["osm", "geonames"]},
          "name": {"type": "string"},
          "url": {"type": "string"},
          "attribution": {"type": "string"}
        }
      }
    },
    "peaks": {"type": "array", "items": {"$ref": "#/$defs/peak"}}
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "required": ["dataset", "id"],
      "additionalProperties": false,
      "properties": {
        "dataset": {"type": "string", "enum": ["osm", "geonames"]},
        "id": {"type": "string"},
        "url": {"type": "string"}
      }
    },
    "peak": {
      "type": "object",
      "required": ["id", "name", "elevation_m", "lat", "lon", "country", "source", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^(osm_n|gn_)[0-9]+(_[a-z0-9_]+)?$"},
        "name": {"type": "string", "minLength": 1},
        "alt_names": {"type": "array", "items": {"type": "string"}},
        "elevation_m": {"type": "number", "minimum": -500, "maximum": 8900},
        "elevation_source": {"type": "string", "enum": ["geonames_dem"]},
        "prominence_m": {"type": ["number", "null"], "minimum": 0, "maximum": 8900},
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lon": {"type": "number", "minimum": -180, "maximum": 180},
        "country": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{2}$"}},
        "tags": {"type": "array", "items": {"type": "string"}},
        "wikidata": {"type": "string", "pattern": "^Q[0-9]+$"},
        "source": {"$ref": "#/$defs/source_ref"},
        "also_in": {"type": "array", "items": {"$ref": "#/$defs/source_ref"}},
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]}
      }
    }
  }
}
